[Unit]
Description=Do Viet Agent dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/doviet_agent
EnvironmentFile=/root/doviet_agent/.env
ExecStart=/root/doviet_agent/venv/bin/python scripts/run_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
