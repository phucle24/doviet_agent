DOVIET_AGENT_GEMINI_API_KEY=your_gemini_api_key
DOVIET_AGENT_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
DOVIET_AGENT_IMAGE_FALLBACK_ON_ERROR=false
DOVIET_AGENT_IMAGE_ASPECT_RATIO=4:5

DOVIET_AGENT_DEEPSEEK_API_KEY=your_deepseek_api_key
DOVIET_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
DOVIET_AGENT_DEEPSEEK_TEXT_MODEL=deepseek-chat

DOVIET_AGENT_FB_PAGE_ID=your_page_id
DOVIET_AGENT_FB_PAGE_TOKEN=your_page_access_token
DOVIET_AGENT_FB_GRAPH_VERSION=v21.0

DOVIET_AGENT_TIMEZONE=Asia/Ho_Chi_Minh
DOVIET_AGENT_DB_PATH=data/agent.db
DOVIET_AGENT_OUTPUT_DIR=assets

DOVIET_AGENT_FONT_BOLD=/System/Library/Fonts/Supplemental/Arial Bold.ttf
DOVIET_AGENT_FONT_REGULAR=/System/Library/Fonts/Supplemental/Arial.ttf

DOVIET_AGENT_WEB_HOST=127.0.0.1
DOVIET_AGENT_WEB_PORT=8020
DOVIET_AGENT_WEB_SECRET_KEY=change-me

DOVIET_AGENT_MIN_FUTURE_POSTS=6
DOVIET_AGENT_TARGET_FUTURE_POSTS=14
DOVIET_AGENT_DIRECT_IMAGE_BOOTSTRAP_DAYS=0
DOVIET_AGENT_DIRECT_IMAGE_BOOTSTRAP_UNTIL=
